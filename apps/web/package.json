{
  "name": "@vinyl/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env server.ts",
    "build": "vp build --outDir dist/client && vp build --ssr src/entry-server.ts --outDir dist/server",
    "start": "NODE_ENV=production node server.ts",
    "test": "vp test run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "@vinyl/shared": "workspace:*",
    "devalue": "^6.0.3",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "vite-plus": "^1.3.0",
    "vue-tsc": "^3.3.13"
  }
}
